@article{Banani2017,
  title    = {Biomolecular condensates: organizers of cellular biochemistry},
  author   = {Banani, Salman F and Lee, Hyun O and Hyman, Anthony A and Rosen, Michael K},
  doi      = {10.1038/nrm.2017.7},
  number   = {5},
  volume   = {18},
  month    = {May},
  year     = {2017},
  journal  = {Nature reviews. Molecular cell biology},
  issn     = {1471-0072},
  pages    = {285—298},
  abstract = {Biomolecular condensates are micron-scale compartments in eukaryotic cells that lack surrounding membranes but function to concentrate proteins and nucleic acids. These condensates are involved in diverse processes, including RNA metabolism, ribosome biogenesis, the DNA damage response and signal transduction. Recent studies have shown that liquid-liquid phase separation driven by multivalent macromolecular interactions is an important organizing principle for biomolecular condensates. With this physical framework, it is now possible to explain how the assembly, composition, physical properties and biochemical and cellular functions of these important structures are regulated.},
  url      = {https://europepmc.org/articles/PMC7434221}
}


